# Docker demo only: cache misses call OpenAI and may incur charges.
# Keep the key in .env (ignored by Git), never in this template.
# For a keyless offline demo, use: llm-cache-router demo
OPENAI_API_KEY=

CACHE_BACKEND=redis
CACHE_THRESHOLD=0.92
CACHE_TTL=3600
LLM_MODEL=gpt-4o-mini
DAILY_BUDGET_USD=5.0
# Budget accounting happens after provider calls; it is not a hard spending cap.
